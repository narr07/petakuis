# Konfigurasi Domain & Reverse Proxy (Oracle Cloud VPS)
DOMAIN=localhost

# Konfigurasi Database & Redis (Docker Compose)
POSTGRES_PASSWORD=petakuis_secret
DATABASE_URL=postgres://petakuis:petakuis_secret@localhost:5432/petakuis
REDIS_URL=redis://localhost:6379

# URL Realtime Game Server
GAME_SERVER_INTERNAL_URL=http://localhost:3001
NUXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
INTERNAL_SECRET=petakuis_internal_secret

# Opsional: Kunci API Gemini untuk Generator Soal AI Server-side
# (Guru juga dapat memasukkan API Key pribadi langsung dari antarmuka web)
GEMINI_API_KEY=
