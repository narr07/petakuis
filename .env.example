# ---------------------------------------------------------------- produksi (VPS)
# Alamat publik situs, lengkap dengan https://. Socket.IO juga lewat alamat ini
# (path /socket.io diarahkan ke game server oleh proxy/tunnel).
PUBLIC_URL=https://petakuis.contoh.id

# Opsional: alamat game server bila dipisah ke subdomain sendiri.
# PUBLIC_GAME_URL=https://petakuis-ws.contoh.id

# Rahasia antara web dan game server. WAJIB acak di produksi, buat dengan:
#   openssl rand -hex 32
INTERNAL_SECRET=

# Port lokal (hanya 127.0.0.1) untuk dipasang di belakang proxy / Cloudflare Tunnel.
WEB_PORT=3100
GAME_PORT=3101

# Opsional: kunci API Gemini untuk generator soal AI di server
# (guru juga bisa memasukkan API key pribadi dari halaman Buat Kuis).
GEMINI_API_KEY=

# Hanya untuk `docker compose --profile caddy` (VPS tanpa proxy lain): domain tanpa https://
# CADDY_DOMAIN=petakuis.contoh.id

# ---------------------------------------------------------------- pengembangan lokal
# Tidak perlu diisi: bawaan sudah mengarah ke localhost:3000 (web) dan localhost:3001 (game server).
# NUXT_GAME_SERVER_INTERNAL_URL=http://localhost:3001
# NUXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
# ALLOWED_ORIGINS=http://localhost:3000
# NUXT_DATABASE_URL=file:.data/petakuis.db   (berkas SQLite, dibuat otomatis)
